# ==========================================
# Backend Environment Configuration (Node.js/Express)
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/whistleapp
# MongoDB Atlas (Cloud) Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/whistleapp?retryWrites=true&w=majority

# Fallback MongoDB URI (if used by certain scripts or cloud setups)
MONGODB_URI=mongodb://127.0.0.1:27017/whistleapp

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:3000

# Cloudinary Configuration (Media & Asset Storage: branding, audio ringtones, advertisements, KYC documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
